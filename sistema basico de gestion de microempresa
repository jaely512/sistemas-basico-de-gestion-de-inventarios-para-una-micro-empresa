import java.util.*;

// Clase que representa una arista
class Arista implements Comparable<Arista> {
    int origen, destino, peso;

    public Arista(int origen, int destino, int peso) {
        this.origen = origen;
        this.destino = destino;
        this.peso = peso;
    }

    // Para ordenar por peso
    @Override
    public int compareTo(Arista otra) {
        return this.peso - otra.peso;
    }
}

// Clase principal del Grafo
class Grafo {
    int numVertices;
    List<Arista> aristas;

    public Grafo(int numVertices) {
        this.numVertices = numVertices;
        this.aristas = new ArrayList<>();
    }

    public void agregarArista(int origen, int destino, int peso) {
        aristas.add(new Arista(origen, destino, peso));
    }

    // Clase interna para Union-Find
    class Subconjunto {
        int padre, rango;
    }

    // Encontrar el representante del conjunto (con compresión de caminos)
    int find(Subconjunto[] subconjuntos, int i) {
        if (subconjuntos[i].padre != i) {
            subconjuntos[i].padre = find(subconjuntos, subconjuntos[i].padre);
        }
        return subconjuntos[i].padre;
    }

    // Unión por rango
    void union(Subconjunto[] subconjuntos, int x, int y) {
        int raizX = find(subconjuntos, x);
        int raizY = find(subconjuntos, y);

        if (subconjuntos[raizX].rango < subconjuntos[raizY].rango) {
            subconjuntos[raizX].padre = raizY;
        } else if (subconjuntos[raizX].rango > subconjuntos[raizY].rango) {
            subconjuntos[raizY].padre = raizX;
        } else {
            subconjuntos[raizY].padre = raizX;
            subconjuntos[raizX].rango++;
        }
    }

    // Método de Kruskal
    public void kruskal() {
        List<Arista> resultado = new ArrayList<>();

        // 1. Ordenar aristas por peso
        Collections.sort(aristas);

        // 2. Crear subconjuntos
        Subconjunto[] subconjuntos = new Subconjunto[numVertices];
        for (int i = 0; i < numVertices; i++) {
            subconjuntos[i] = new Subconjunto();
            subconjuntos[i].padre = i;
            subconjuntos[i].rango = 0;
        }

        int i = 0;
        while (resultado.size() < numVertices - 1 && i < aristas.size()) {
            Arista siguiente = aristas.get(i++);

            int x = find(subconjuntos, siguiente.origen);
            int y = find(subconjuntos, siguiente.destino);

            // Si no forma ciclo, se agrega
            if (x != y) {
                resultado.add(siguiente);
                union(subconjuntos, x, y);
            }
        }

        // Mostrar resultado
        System.out.println("Árbol de Expansión Mínima (Kruskal):");
        for (Arista a : resultado) {
            System.out.println(a.origen + " -- " + a.destino + " == " + a.peso);
        }
    }
}

// Clase de prueba
public class Main {
    public static void main(String[] args) {
        Grafo grafo = new Grafo(4);

        grafo.agregarArista(0, 1, 10);
        grafo.agregarArista(0, 2, 6);
        grafo.agregarArista(0, 3, 5);
        grafo.agregarArista(1, 3, 15);
        grafo.agregarArista(2, 3, 4);

        grafo.kruskal();
    }
}
